# Code owners are the people who must approve a change to the files named here (decision D34).
# A change to any other file needs only the passing checks, so ordinary work is not held up waiting for a second person.
# The branch rule asks, for the files below, for one approval from a maintainer (the author of a pull request cannot approve their own).
# @AeonAgents/maintainers is the team of the maintainers (organisation settings, Teams); add or remove people there, not here.

# What decides what the agent may do, and what it may reach.
/src/core/policy.ts       @AeonAgents/maintainers
/src/node/fs-guard.ts     @AeonAgents/maintainers
/src/node/net-guard.ts    @AeonAgents/maintainers
/src/node/server/         @AeonAgents/maintainers
/src/node/skill-*.ts      @AeonAgents/maintainers
/src/node/tools/          @AeonAgents/maintainers
/src/node/memory.ts       @AeonAgents/maintainers

# Code that runs with the release signing key or decides what runs there: the CI and release workflows, the build scripts, the Gradle wrapper, the npm packages.
/.github/                 @AeonAgents/maintainers
/ui/gradle/               @AeonAgents/maintainers
/ui/*.gradle.kts          @AeonAgents/maintainers
/ui/*/build.gradle.kts    @AeonAgents/maintainers
/package.json             @AeonAgents/maintainers
/tools/package-agent.mjs  @AeonAgents/maintainers
/tools/agent-runtime.json @AeonAgents/maintainers
/package-lock.json        @AeonAgents/maintainers

# Decisions, threat model, licence.
/docs/DECISIONS.md        @AeonAgents/maintainers
/docs/THREAT_MODEL.md     @AeonAgents/maintainers
/LICENSE                  @AeonAgents/maintainers
